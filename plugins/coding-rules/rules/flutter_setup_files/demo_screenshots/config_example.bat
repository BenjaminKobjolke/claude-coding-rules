@rem Password for the local API demo seed endpoint. Default: not set.
set "DEMO_ADMIN_PASSWORD="
@rem Local API root used for seeding. Default: http://localhost/api/v1.
set "DEMO_API_URL=http://localhost/api/v1"
@rem API URL reached by the Android emulator app. Default: http://10.0.2.2/api.
set "DEMO_APP_SERVER_URL=http://10.0.2.2/api"
@rem API URL reached by the Windows app. Default: http://localhost/api.
set "DEMO_WINDOWS_SERVER_URL=http://localhost/api"
@rem Screenshot tool project directory. Default: %USERPROFILE%\.automated-application-screenshots.
set "SCREENSHOT_TOOL_DIR=%USERPROFILE%\.automated-application-screenshots"
